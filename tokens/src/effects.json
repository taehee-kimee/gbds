{
  "shadow": {
    "$type": "shadow",
    "2xs": { "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "0px", "spread": "0px", "color": "rgb(0 0 0 / 5%)" } },
    "xs": { "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "rgb(0 0 0 / 10%)" } },
    "sm": { "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px", "color": "rgb(0 0 0 / 10%)" } },
    "md": {
      "$value": [
        { "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "-2px", "color": "rgb(0 0 0 / 10%)" },
        { "offsetX": "0px", "offsetY": "4px", "blur": "6px", "spread": "-1px", "color": "rgb(0 0 0 / 10%)" }
      ]
    },
    "lg": {
      "$value": [
        { "offsetX": "0px", "offsetY": "4px", "blur": "6px", "spread": "-4px", "color": "rgb(0 0 0 / 10%)" },
        { "offsetX": "0px", "offsetY": "10px", "blur": "15px", "spread": "-3px", "color": "rgb(0 0 0 / 10%)" }
      ]
    },
    "xl": {
      "$value": [
        { "offsetX": "0px", "offsetY": "8px", "blur": "10px", "spread": "-6px", "color": "rgb(0 0 0 / 10%)" },
        { "offsetX": "0px", "offsetY": "20px", "blur": "25px", "spread": "-5px", "color": "rgb(0 0 0 / 10%)" }
      ]
    },
    "2xl": { "$value": { "offsetX": "0px", "offsetY": "25px", "blur": "50px", "spread": "-12px", "color": "rgb(0 0 0 / 25%)" } },
    "inner": { "$value": { "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px", "color": "rgb(0 0 0 / 6%)", "inset": true } },
    "none": { "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px", "color": "rgb(0 0 0 / 0%)" } }
  },

  "ring": {
    "$type": "shadow",
    "$description": "Figma `Box Shadow/Focus ring` and `Box Shadow/Destructive`. Apply with box-shadow on :focus-visible.",
    "focus": { "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "3px", "color": "rgb(161 161 161 / 50%)" } },
    "destructive": { "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "3px", "color": "rgb(220 38 38 / 20%)" } }
  },

  "blur": {
    "$type": "dimension",
    "$description": "Use as filter: blur(var(--blur-md)) or backdrop-filter: blur(var(--blur-md)). Figma splits Blur and Backdrop Blur but the scales are identical.",
    "none": { "$value": "0px" },
    "sm": { "$value": "4px" },
    "default": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "24px" },
    "2xl": { "$value": "40px" },
    "3xl": { "$value": "64px" }
  }
}
