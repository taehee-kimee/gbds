  "space": {
    "$type": "dimension",
    "$description": "Figma `space/sp-N`. Name equals the pixel value.",
    "0": { "$value": "0px" },
    "2": { "$value": "2px" },
    "4": { "$value": "4px" },
    "6": { "$value": "6px" },
    "8": { "$value": "8px" },
    "10": { "$value": "10px" },
    "12": { "$value": "12px" },
    "14": { "$value": "14px" },
    "16": { "$value": "16px" },
    "20": { "$value": "20px" },
    "24": { "$value": "24px" },
    "28": { "$value": "28px" },
    "32": { "$value": "32px" },
    "36": { "$value": "36px" },
    "40": { "$value": "40px" },
    "44": { "$value": "44px" },
    "48": { "$value": "48px" },
    "64": { "$value": "64px" },
    "80": { "$value": "80px" },
    "96": { "$value": "96px" },
    "128": { "$value": "128px" },
    "256": { "$value": "256px" }
  },

  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "xs": { "$value": "2px" },
    "sm": { "$value": "6px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "10px" },
    "xl": { "$value": "14px" },
    "2xl": { "$value": "18px" },
    "3xl": { "$value": "22px" },
    "4xl": { "$value": "26px" },
    "full": { "$value": "9999px" }
  },

  "stroke": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "1": { "$value": "1px" },
    "2": { "$value": "2px" },
    "3": { "$value": "3px" }
  },

  "opacity": {
    "$type": "number",
    "$description": "CSS 0–1 scale. Figma stores the same tokens on a 0–100 scale (opacity/50 = 50).",
    "50": { "$value": 0.5 },
    "70": { "$value": 0.7 },
    "80": { "$value": 0.8 },
    "85": { "$value": 0.85 },
    "90": { "$value": 0.9 },
    "100": { "$value": 1 }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] },
      "timestamp": {
        "$value": ["Bitcount Grid Single", "ui-monospace", "monospace"],
        "$description": "Not a Figma variable — taken from the `Time Stamp/Regular` text style."
      }
    },
    "size": {
      "$type": "dimension",
      "xxs": { "$value": "8px" },
      "xs": { "$value": "12px" },
      "sm": { "$value": "14px" },
      "base": { "$value": "16px" },
      "lg": { "$value": "18px" },
      "xl": { "$value": "20px" },
      "2xl": { "$value": "24px" },
      "3xl": { "$value": "30px" },
      "4xl": { "$value": "36px" },
      "5xl": { "$value": "48px" },
      "6xl": { "$value": "60px" },
      "7xl": { "$value": "72px" },
      "8xl": { "$value": "96px" },
      "9xl": { "$value": "128px" }
    },
    "leading": {
      "$type": "dimension",
      "$description": "Line height. Step × 4 = px.",
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "5": { "$value": "20px" },
      "6": { "$value": "24px" },
      "7": { "$value": "28px" },
      "8": { "$value": "32px" },
      "9": { "$value": "36px" },
      "10": { "$value": "40px" },
      "12": { "$value": "48px" },
      "15": { "$value": "60px" },
      "18": { "$value": "72px" },
      "24": { "$value": "96px" },
      "32": { "$value": "128px" }
    },
    "weight": {
      "$type": "fontWeight",
      "thin": { "$value": 100 },
      "extralight": { "$value": 200 },
      "light": { "$value": 300 },
      "normal": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 },
      "black": { "$value": 900 }
    },
    "tracking": {
      "$type": "dimension",
      "normal": { "$value": "0px" }
    }
  }
